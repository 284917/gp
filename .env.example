# Строка подключения к Postgres (Neon, Supabase, Vercel Postgres и т. п.).
# На Vercel при подключении базы через Storage переменная появляется сама
# (DATABASE_URL или POSTGRES_URL — подойдёт любая).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Секрет для подписи сессий. Любая длинная случайная строка.
AUTH_SECRET=замените-на-длинную-случайную-строку

# Первый настоящий куратор (создаётся при сборке, если такой почты ещё нет).
ADMIN_EMAIL=curator@example.com
ADMIN_PASSWORD=смените-этот-пароль
ADMIN_NAME=Главный куратор

# Хранилище файлов Vercel Blob — для загрузки фото, видео и голосовых.
# На Vercel при подключении Blob в разделе Storage появляется BLOB_STORE_ID (вход через OIDC).
# Вне Vercel нужен токен чтения и записи. Публичное хранилище: BLOB_ACCESS=public.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
